{
    "name": "enflow/redirect-pizza-php-sdk",
    "description": "An SDK to easily work with the redirect.pizza API",
    "keywords": [
        "redirect.pizza",
        "api",
        "sdk"
    ],
    "homepage": "https://github.com/enflow/redirect-pizza-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Michel Bardelmeijer",
            "email": "michel@enflow.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "saloonphp/pagination-plugin": "^2.2",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "pestphp/pest": "^2.35|^3.8.2",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "RedirectPizza\\PhpSdk\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RedirectPizza\\PhpSdk\\Tests\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest -p",
        "analyse": "vendor/bin/phpstan analyse",
        "baseline": "vendor/bin/phpstan analyse --generate-baseline"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true
        }
    }
}
